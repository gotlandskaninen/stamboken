FROM ghcr.io/rustfs/rustfs:1.0.0

# Run as root: the image defaults to a non-root user (10001:10001), which
# cannot write to a bind-mounted ./s3data host directory that Docker creates
# as root on first start. This is a throwaway dev-only container.
USER root

COPY .docker/rustfs-entrypoint.sh /usr/bin/rustfs-entrypoint.sh
RUN chmod +x /usr/bin/rustfs-entrypoint.sh

ENTRYPOINT ["/usr/bin/rustfs-entrypoint.sh"]
