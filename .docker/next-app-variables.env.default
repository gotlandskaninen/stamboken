# Google OAuth Configuration for Next.js
# Replace with your actual Google Client ID from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Payload CMS database connection. MUST use the same password as
# .docker/cms-database-variables.env (POSTGRES_PASSWORD). Set here (not in
# docker-compose) so it is not overridden by an empty compose interpolation.
CMS_DATABASE_URL=postgres://herdbook_cms:CHANGE_ME_SAME_AS_CMS_DB@cms-database:5432/herdbook_cms

# Long random string — Payload fails to boot in production without it.
PAYLOAD_SECRET=CHANGE_ME_long_random_string

# CMS admin allowlist email seeded into Payload Users (your Stamboken/Google login).
# Must match the email Payload sees from the Flask session, i.e. your
# @gotlandskaninen.se Google account.
CMS_ADMIN_EMAIL=admin@example.com