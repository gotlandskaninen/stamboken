# SECRET_KEY is Flask's signing secret (OAuth state etc.). Sessions are shared
# across api/api-test via the Redis store (db 2); the session cookie itself is
# unsigned in Flask-Session 0.8, so rotating SECRET_KEY does NOT invalidate
# sessions — to force-logout everyone: docker exec <redis> redis-cli -n 2 flushdb.
# Set the SAME value here as in api-variables.env (production refuses to start
# without it). NEVER commit a real key — this template documents the name only.
HERDBOOK_HOST=https://test.gotlandskaninen.se
HERDBOOK_LOGFOLDER=/logs/
# Expected audience for Google ID tokens — SAME value as GOOGLE_CLIENT_ID in
# api-variables.env (the GIS client id). Required here too: /api-test/auth/google
# is publicly reachable, and an unpinned api-test would let any Google app's
# tokens sign in to the demo, which holds a nightly copy of production data.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# PDF signing explicitly disabled on test instance
PDF_SIGNING_ENABLED=false
# S3 credentials intentionally omitted — test instance cannot write certificates
