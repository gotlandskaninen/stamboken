# SECRET_KEY is Flask's signing secret (OAuth state etc.). Sessions are shared
# across api/api-test via the Redis store (db 2); the session cookie itself is
# unsigned in Flask-Session 0.8, so rotating SECRET_KEY does NOT invalidate
# sessions — to force-logout everyone: docker exec <redis> redis-cli -n 2 flushdb.
# Set the SAME value here and in api-test-variables.env (production refuses to
# start without it). Generate once with:
# python3 -c "import secrets; print(secrets.token_hex(32))".
# NEVER commit a real key — this .default template documents the name only.
HERDBOOK_HOST=https://127.0.0.1:8443
HERDBOOK_LOGFOLDER=/logs/
# Expected audience for Google ID tokens from the Next.js sign-in: the GIS
# client id, NOT the Flask OAuth client in auth.ini. In production the
# browser bundle bakes in the GitHub Actions repo variable
# NEXT_PUBLIC_GOOGLE_CLIENT_ID at image build — copy THAT exact value here
# AND into api-test-variables.env (api-test serves /api-test/auth/google
# publicly and mints sessions production honors). If unset, the audience
# check is skipped (production logs a warning).
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
S3_ACCESSKEY=accesskeytest
S3_BUCKET=test
S3_ENDPOINT=http://s3backend:9000
S3_REGION=us-east-1
S3_SECRETKEY=secretkeytest
# Committed dev/test CA (app/certs/, see its README). A production instance
# refuses to start with it: set your own key and CA here, e.g.
# /config/pdf_signing_key.pem and /config/pdf_signing_ca.pem. After a key
# rotation, list the previous CA(s) in PDF_SIGNING_TRUST_CAS (comma-separated)
# so certificates issued before it still verify.
PDF_SIGNING_KEY=certs/key.pem
PDF_SIGNING_CA=certs/ca.pem
#PDF_SIGNING_TRUST_CAS=/config/pdf_signing_ca_2022.pem
# Outgoing mail (docs/mejl.md). log: no SMTP connection, the mail is only
# logged (the default). allowlist: sends only to MAIL_ALLOWLIST, comma-separated
# full addresses or @domain entries. live: sends; refused when DEMO_INSTANCE=true.
MAIL_MODE=log
#MAIL_ALLOWLIST=@example.org,someone@example.net
#SMTP_HOST=smtp-relay.gmail.com
#SMTP_PORT=587
#MAIL_FROM=stamboken@gotlandskaninen.se
# HMAC key for link tokens, Message-IDs and address hashes; its own secret per
# environment, not SECRET_KEY. Required unless MAIL_MODE=log. Changing it
# invalidates every link already sent. Generate once with
# python3 -c "import secrets; print(secrets.token_hex(32))". NEVER commit a real one.
#LINK_SECRET=
# Reading the association's mailbox into the intake queue (docs/inkorg-gmail.md).
# on reads INBOX every 5 minutes and moves what it read to the trash; refused
# when DEMO_INSTANCE=true, and requires the three GMAIL_ values and LINK_SECRET.
# The refresh token comes from `flask gmail consent`. NEVER commit real values.
INLASNING_GMAIL=off
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# The intake queue's image reading (docs/inkorg.md, "Tolkning"). av: no photo is
# read and the handler types every field (the default). gemma: the local model
# on the ollama service reads the photos one at a time; pull the model first.
INLASNING_TOLKARE=av
#INLASNING_MODELL=gemma4
#OLLAMA_URL=http://ollama:11434

# Months an original photo of a certificate or a proof is kept after it came in
# (docs/inkorg.md, "Gallring"); the masked copy on the rabbit is never removed.
#INLASNING_ORIGINAL_MANADER=12
